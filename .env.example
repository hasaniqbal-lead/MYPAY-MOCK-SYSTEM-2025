# ===========================================
# MyPay Mock Platform - Environment Variables
# ===========================================

# Database Configuration (Unified MySQL)
DATABASE_URL=mysql://root:mypay_secret@localhost:3306/mypay_mock_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mypay_secret
DB_NAME=mypay_mock_db

# ===========================================
# Service Ports
# ===========================================
PAYOUT_API_PORT=4001
PAYMENT_API_PORT=4002
MERCHANT_PORTAL_PORT=4010
ADMIN_PORTAL_PORT=4011
PAYMENT_PAGE_PORT=4012

# ===========================================
# Payout API Configuration
# ===========================================
PAYOUT_API_URL=http://localhost:4001
WEBHOOK_SECRET=your-webhook-secret-key
IPN_PORT=4003

# ===========================================
# Payment API Configuration
# ===========================================
PAYMENT_API_URL=http://localhost:4002
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# ===========================================
# Payment Page Configuration
# ===========================================
# URL where the payment page is hosted (checkout redirects here)
PAYMENT_PAGE_URL=http://localhost:4020
# In production: https://pay.mycodigital.io

# ===========================================
# Portal Configuration
# ===========================================
# Merchant Portal
NEXT_PUBLIC_API_URL=https://sandbox.mycodigital.io
NEXT_PUBLIC_PORTAL_URL=https://devportal.mycodigital.io

# Admin Portal
NEXT_PUBLIC_ADMIN_API_URL=https://sandbox.mycodigital.io
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://devadmin.mycodigital.io

# ===========================================
# Production Domains (mycodigital.io - Legacy)
# ===========================================
SANDBOX_DOMAIN=sandbox.mycodigital.io
MERCHANT_PORTAL_DOMAIN=devportal.mycodigital.io
ADMIN_PORTAL_DOMAIN=devadmin.mycodigital.io
PAYMENT_PAGE_DOMAIN=pay.mycodigital.io

# ===========================================
# Production Domains (mypay.mx - Primary)
# ===========================================
# Sandbox/Mock Environment
MYPAY_PAYOUT_DOMAIN=sandbox.mypay.mx
MYPAY_PAYMENT_DOMAIN=test.mypay.mx
MYPAY_MERCHANT_PORTAL_DOMAIN=devportal.mypay.mx
MYPAY_ADMIN_PORTAL_DOMAIN=devadmin.mypay.mx
MYPAY_PAYMENT_PAGE_DOMAIN=demo.mypay.mx

# ===========================================
# Node Environment
# ===========================================
NODE_ENV=development
