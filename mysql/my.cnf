[mysqld]
# ==================================================
# MyPay MySQL Performance Optimization Configuration
# ==================================================
# Optimized for VPS with limited resources
# Target: Reduce disk-based temp tables and CPU usage

# Memory Settings
# ---------------
# Allocate 50-60% of available RAM to InnoDB buffer pool
innodb_buffer_pool_size = 512M

# Reduce disk-based temporary tables
tmp_table_size = 64M
max_heap_table_size = 64M

# InnoDB Settings
# ---------------
# Reduce fsync frequency for better performance
innodb_flush_log_at_trx_commit = 2
innodb_redo_log_capacity = 268435456  # 256MB (replaces innodb_log_file_size in MySQL 8.0.30+)
innodb_log_buffer_size = 16M

# Use InnoDB for temp tables instead of MyISAM
# internal_tmp_disk_storage_engine = InnoDB  # Not supported in MySQL 8.0.44+
# MySQL 8.0.16+ uses InnoDB by default for on-disk internal temporary tables

# Connection Management
# ---------------------
# Limit concurrent connections
max_connections = 50

# Kill idle connections after 5 minutes
wait_timeout = 300
interactive_timeout = 300

# Query Optimization
# ------------------
# Sort buffer for ORDER BY operations
sort_buffer_size = 2M

# Join buffer size
join_buffer_size = 2M

# Read buffer
read_buffer_size = 1M
read_rnd_buffer_size = 2M

# Slow Query Log (For Investigation)
# -----------------------------------
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow-query.log
long_query_time = 2
log_queries_not_using_indexes = 1

# Performance Schema (Optional - can be disabled to save RAM)
# ------------------------------------------------------------
performance_schema = OFF

# Binary Logging (Disable if not needed for replication)
# -------------------------------------------------------
skip-log-bin = 1

# Thread Cache
# ------------
thread_cache_size = 8

# Table Cache
# -----------
table_open_cache = 2000
table_definition_cache = 1000

# Character Set
# -------------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

[mysql]
# Default character set for mysql client
default-character-set = utf8mb4

[client]
# Default character set for all clients
default-character-set = utf8mb4

