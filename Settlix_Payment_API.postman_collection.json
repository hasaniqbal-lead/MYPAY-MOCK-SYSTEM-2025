        {
          "name": "Create Checkout (Easypaisa)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var cid = jsonData.checkoutId || (jsonData.data && jsonData.data.checkoutId);",
                  "if (cid) { pm.collectionVariables.set(\"checkoutId\", cid); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
