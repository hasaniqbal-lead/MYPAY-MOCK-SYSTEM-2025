// ============================================
// DarPay Mock Platform - Unified Prisma Schema
// ============================================
// This schema combines both Payout and Payment services
// into a single unified database schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// SHARED MODELS (Used by both services)
// ============================================

// Unified Merchant model for both Payout and Payment APIs
model Merchant {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  name          String    // Used by Payout API
  company_name  String?   // Used by Payment API portal
  email         String    @unique
  password_hash String?   // For portal login
  apiKey        String    @unique // Hashed API key for Payout API (for authentication)
  apiKeyPlain   String?   // Plain API key for Payout API (for display in portal)
  webhookUrl    String?
  isActive      Boolean   @default(true)
  status        String    @default("active") // For portal: active, inactive, suspended
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Payout API relations
  balances          MerchantBalance[]
  payouts           Payout[]
  ledgerEntries     LedgerEntry[]
  outboxEvents      OutboxEvent[]
  webhookDeliveries WebhookDelivery[]

  // Payment API relations
  apiKeys           ApiKey[]
  transactions      PaymentTransaction[]

  // Payment Page Configuration relations
  paymentPageConfigs PaymentPageConfig[]

  // Phase 2-6 relations
  refunds            Refund[]
  teamMembers        MerchantTeamMember[]
  supportTickets     SupportTicket[]
  settlements        Settlement[]
  merchantRates      MerchantRate[]
  documents          Document[]

  @@map("merchants")
}

// ============================================
// PAYOUT API MODELS
// ============================================

model MerchantBalance {
  id            String   @id @default(uuid())
  merchantId    Int
  balance       Decimal  @default(0) @db.Decimal(15, 2)
  lockedBalance Decimal  @default(0) @db.Decimal(15, 2)
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId])
  @@map("merchant_balances")
}

model Payout {
  id                String    @id @default(uuid())
  merchantId        Int
  merchantReference String
  amount            Decimal   @db.Decimal(15, 2)
  currency          String    @default("PKR")
  destType          String    // BANK, WALLET
  bankCode          String?
  walletCode        String?
  accountNumber     String
  accountTitle      String
  status            String    @default("PENDING")
  failureReason     String?
  pspReference      String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ledgerEntries     LedgerEntry[]

  @@unique([merchantId, merchantReference])
  @@index([merchantId])
  @@index([status])
  @@index([createdAt])                         // NEW: For date filtering
  @@index([merchantId, createdAt])             // NEW: Compound index for merchant queries
  @@index([merchantId, status])                // NEW: Compound index for status filtering
  @@index([merchantId, status, createdAt])     // NEW: Covering index for dashboard
  @@map("payouts")
}

model LedgerEntry {
  id          String   @id @default(uuid())
  merchantId  Int
  payoutId    String?
  type        String   // DEBIT, CREDIT
  amount      Decimal  @db.Decimal(15, 2)
  balance     Decimal  @db.Decimal(15, 2)
  description String
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payout      Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([payoutId])
  @@map("ledger_entries")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  merchantId  Int
  eventType   String
  payload     String    @db.Text
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([processed])
  @@map("outbox_events")
}

model PayoutIdempotencyKey {
  id          String   @id @default(uuid())
  merchantId  Int
  key         String
  requestHash String
  response    String?  @db.Text
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([merchantId, key])
  @@index([expiresAt])
  @@map("payout_idempotency_keys")
}

model WebhookDelivery {
  id          String    @id @default(uuid())
  merchantId  Int
  eventType   String
  payload     String    @db.Text
  signature   String
  status      String    @default("PENDING")
  statusCode  Int?
  response    String?   @db.Text
  attempts    Int       @default(0)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([status])
  @@map("webhook_deliveries")
}

model BankDirectory {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bank_directory")
}

model WalletDirectory {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallet_directory")
}

// ============================================
// PAYMENT API MODELS
// ============================================

// API Keys for checkout authentication (Payment API)
model ApiKey {
  id              Int      @id @default(autoincrement())
  vendor_id       String   @unique
  api_key         String   @unique
  api_secret      String   @db.Text
  merchant_id     Int?
  is_active       Boolean  @default(true)
  label           String?  @default("Default")
  allowed_methods Json?    // ["easypaisa","jazzcash","card"] or null for all
  created_at      DateTime @default(now())

  merchant    Merchant? @relation(fields: [merchant_id], references: [id], onDelete: SetNull)

  @@map("payment_api_keys")
}

// Payment transactions
model PaymentTransaction {
  id               Int       @id @default(autoincrement())
  checkout_id      String    @unique
  vendor_id        String?
  reference        String
  amount           Decimal   @db.Decimal(10, 2)
  payment_method   String
  payment_type     String
  success_url      String    @db.Text
  return_url       String    @db.Text
  status           String    @default("pending")
  status_code      String?
  mobile_number    String?
  user_data        Json?
  webhook_status   String    @default("pending")
  webhook_attempts Int       @default(0)
  merchant_id      Int?
  config_id        Int?      // Payment page configuration used for this checkout
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  merchant         Merchant? @relation(fields: [merchant_id], references: [id], onDelete: SetNull)

  @@index([checkout_id])
  @@index([reference])
  @@index([status])
  @@index([merchant_id])
  @@index([created_at])                          // NEW: For dashboard date filtering
  @@index([merchant_id, created_at])             // NEW: Compound index for merchant queries
  @@index([merchant_id, status])                 // NEW: Compound index for status filtering
  @@index([merchant_id, status, created_at])     // NEW: Covering index for dashboard
  @@map("payment_transactions")
}

// Test scenario mappings for mobile numbers
model ScenarioMapping {
  id            Int      @id @default(autoincrement())
  mobile_number String   @unique
  scenario      String
  status        String
  status_code   String
  description   String   @db.Text
  created_at    DateTime @default(now())

  @@map("scenario_mappings")
}

// Payment webhook delivery logs
model PaymentWebhookLog {
  id              Int      @id @default(autoincrement())
  checkout_id     String
  url             String   @db.Text
  payload         Json?
  response_status Int?
  response_body   String?  @db.Text
  error_message   String?  @db.Text
  attempt_number  Int      @default(1)
  created_at      DateTime @default(now())

  @@index([checkout_id])
  @@map("payment_webhook_logs")
}

// ============================================
// ADMIN MODELS (For Admin Portal)
// ============================================

model AdminUser {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  name          String
  role          String    @default("admin") // admin, super_admin
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("admin_users")
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.Text
  description String?
  updated_at  DateTime @updatedAt

  @@map("system_config")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_type   String   // admin, merchant
  user_id     Int
  action      String
  resource    String
  resource_id String?
  details     Json?
  ip_address  String?
  created_at  DateTime @default(now())

  @@index([user_type, user_id])
  @@index([action])
  @@index([created_at])
  @@index([created_at, user_type])              // NEW: For log cleanup queries
  @@map("audit_logs")
}

// ============================================
// PAYMENT PAGE CONFIGURATION MODELS
// ============================================

// Merchant payment page theme configurations
model PaymentPageConfig {
  id            Int       @id @default(autoincrement())
  merchant_id   Int
  name          String    // e.g., "Default Theme", "Holiday Theme"
  description   String?   @db.Text
  is_default    Boolean   @default(false)
  is_active     Boolean   @default(true)

  // Configuration JSON sections (ThemeConfiguration)
  branding      Json      // BrandingConfig: merchantLogo, merchantName, favicon
  colors        Json      // ColorConfig: primary, secondary, accent, success, error, etc.
  typography    Json      // TypographyConfig: fontFamily, fontSize, fontWeight
  layout        Json      // LayoutConfig: type, maxWidth, padding, borderRadius, shadow
  channels      Json      // ChannelsConfig: enabled, displayStyle, showIcons, channelOrder
  text          Json      // TextConfig: heading, subheading, labels, buttons, messages
  legal         Json      // LegalConfig: showTerms, showPrivacy, showRefund, texts, urls
  result_pages  Json      // ResultPagesConfig: success (confetti, message, cta), failure
  advanced      Json      // AdvancedConfig: showPoweredBy, enableAnalytics, customCSS
  visibility    Json?     // UIVisibilityConfig: header, amount, channels, form, footer
  form_config   Json?     // FormFieldConfig: phone, email, name field settings
  otp_config    Json?     // OTPConfigExtended: enabled, length, timeout, resendLimit

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  merchant      Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@unique([merchant_id, name])
  @@index([merchant_id])
  @@index([is_active])
  @@index([merchant_id, is_default])
  @@map("payment_page_configs")
}

// Admin-defined rules for field-level locks and validation
model PaymentPageRule {
  id            Int       @id @default(autoincrement())
  field_path    String    @unique  // e.g., "advanced.showPoweredBy", "colors.primary"
  rule_type     String    // "required", "allowed_values", "locked", "regex", "range"
  rule_value    Json      // Rule-specific data: { value, values[], pattern, min, max, message }
  description   String?   @db.Text
  is_active     Boolean   @default(true)
  priority      Int       @default(0)  // Higher priority rules are checked first
  created_by    Int?      // Admin user ID who created the rule
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([rule_type])
  @@index([is_active])
  @@map("payment_page_rules")
}

// Pre-defined templates for quick configuration
model PaymentPageTemplate {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  slug          String    @unique  // URL-friendly identifier
  category      String    // "e-commerce", "subscription", "services", "events"
  description   String?   @db.Text
  thumbnail_url String?   // Preview image URL
  configuration Json      // Full ThemeConfiguration object
  tags          Json?     // Array of tags for filtering
  is_active     Boolean   @default(true)
  is_featured   Boolean   @default(false)
  usage_count   Int       @default(0)  // Track popularity
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([category])
  @@index([is_active])
  @@index([is_featured])
  @@map("payment_page_templates")
}

// ============================================
// Phase 2-6 Models
// ============================================

// Refund requests
model Refund {
  id               Int       @id @default(autoincrement())
  transaction_id   Int
  merchant_id      Int
  checkout_id      String    // Links to PaymentTransaction.checkout_id
  amount           Decimal   @db.Decimal(10, 2)
  original_amount  Decimal   @db.Decimal(10, 2)
  type             String    @default("full")   // "full" or "partial"
  reason           String?   @db.Text
  status           String    @default("pending") // pending, approved, completed, rejected
  admin_note       String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  merchant         Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@index([checkout_id])
  @@index([status])
  @@map("refunds")
}

// Merchant team members
model MerchantTeamMember {
  id            Int       @id @default(autoincrement())
  merchant_id   Int
  name          String
  email         String    @unique
  password_hash String
  role          String    @default("viewer")  // admin, viewer, accountant
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  merchant      Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@map("merchant_team_members")
}

// Support tickets
model SupportTicket {
  id          Int       @id @default(autoincrement())
  merchant_id Int
  subject     String
  status      String    @default("open")  // open, in_progress, resolved, closed
  priority    String    @default("medium") // low, medium, high
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  merchant    Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  messages    TicketMessage[]

  @@index([merchant_id])
  @@index([status])
  @@map("support_tickets")
}

// Ticket messages (conversation thread)
model TicketMessage {
  id             Int       @id @default(autoincrement())
  ticket_id      Int
  sender_type    String    // "merchant" or "admin"
  sender_name    String?
  message        String    @db.Text
  attachment_url String?
  created_at     DateTime  @default(now())

  ticket         SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@map("ticket_messages")
}

// Settlement requests
model Settlement {
  id            Int       @id @default(autoincrement())
  merchant_id   Int
  amount        Decimal   @db.Decimal(12, 2)
  period_start  DateTime
  period_end    DateTime
  status        String    @default("pending") // pending, in_review, approved, completed, rejected
  admin_note    String?   @db.Text
  requested_at  DateTime  @default(now())
  completed_at  DateTime?
  updated_at    DateTime  @updatedAt

  merchant      Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@index([status])
  @@map("settlements")
}

// ============================================
// Phase 2: Operations Center Models
// ============================================

// Blacklist entries (customers, IPs, phones)
model BlacklistEntry {
  id          Int       @id @default(autoincrement())
  type        String    // "phone", "email", "ip", "merchant"
  value       String
  reason      String?   @db.Text
  added_by    String?   // admin email
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  expires_at  DateTime?

  @@unique([type, value])
  @@index([type])
  @@index([is_active])
  @@map("blacklist_entries")
}

// Payment method configuration (global)
model PaymentMethodConfig {
  id              Int       @id @default(autoincrement())
  method          String    @unique // "easypaisa", "jazzcash", "card"
  display_name    String
  is_enabled      Boolean   @default(true)
  min_amount      Decimal   @default(1) @db.Decimal(10, 2)
  max_amount      Decimal   @default(500000) @db.Decimal(10, 2)
  daily_limit     Decimal?  @db.Decimal(12, 2)
  icon_url        String?
  updated_at      DateTime  @updatedAt

  @@map("payment_method_configs")
}

// Admin notifications (to merchants)
model AdminNotification {
  id          Int       @id @default(autoincrement())
  type        String    @default("info") // "info", "warning", "alert", "maintenance"
  title       String
  message     String    @db.Text
  target      String    @default("all") // "all" or merchant_id
  sent_by     String?   // admin email
  is_read     Boolean   @default(false)
  created_at  DateTime  @default(now())

  @@index([target])
  @@index([created_at])
  @@map("admin_notifications")
}

// Activity logs (admin audit trail)
model ActivityLog2 {
  id          Int       @id @default(autoincrement())
  admin_id    Int?
  admin_email String?
  action      String    // "create", "update", "delete", "approve", "reject"
  entity_type String    // "merchant", "refund", "settlement", "ticket", etc.
  entity_id   String?
  details     Json?
  ip_address  String?
  created_at  DateTime  @default(now())

  @@index([admin_email])
  @@index([entity_type])
  @@index([created_at])
  @@map("activity_logs_v2")
}

// ============================================
// Phase 3: PSP Management Models
// ============================================

// Payment Service Provider
model PSP {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique  // "easypaisa_psp", "jazzcash_psp", "card_mastercard"
  logo_url    String?
  is_active   Boolean   @default(true)
  environment String    @default("sandbox") // "sandbox" or "production"
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  credentials PSPCredential[]
  rates       PSPRate[]

  @@map("psps")
}

// PSP Credentials (per environment)
model PSPCredential {
  id            Int       @id @default(autoincrement())
  psp_id        Int
  environment   String    @default("sandbox")
  api_key       String?   @db.Text
  api_secret    String?   @db.Text
  merchant_id   String?   // PSP-assigned merchant ID
  webhook_url   String?
  extra_config  Json?     // Additional PSP-specific config
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  psp           PSP       @relation(fields: [psp_id], references: [id], onDelete: Cascade)

  @@unique([psp_id, environment])
  @@map("psp_credentials")
}

// PSP Rates (what PSP charges us)
model PSPRate {
  id              Int       @id @default(autoincrement())
  psp_id          Int
  payment_method  String    // "easypaisa", "jazzcash", "card"
  rate_percent    Decimal   @db.Decimal(6, 4)  // e.g. 1.5000
  fixed_fee       Decimal   @default(0) @db.Decimal(10, 2) // Fixed fee per transaction
  currency        String    @default("PKR")
  effective_from  DateTime  @default(now())
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())

  psp             PSP       @relation(fields: [psp_id], references: [id], onDelete: Cascade)

  @@index([psp_id, payment_method])
  @@map("psp_rates")
}

// Merchant-specific rates (what we charge merchants — overrides default)
model MerchantRate {
  id              Int       @id @default(autoincrement())
  merchant_id     Int
  payment_method  String
  rate_percent    Decimal   @db.Decimal(6, 4)
  fixed_fee       Decimal   @default(0) @db.Decimal(10, 2)
  effective_from  DateTime  @default(now())
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())

  merchant        Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id, payment_method])
  @@map("merchant_rates")
}

// ============================================
// Phase C: Document Management
// ============================================

model Document {
  id            Int       @id @default(autoincrement())
  merchant_id   Int?
  title         String
  description   String?   @db.Text
  type          String    @default("general") // "policy", "form", "request", "kyc", "general"
  file_url      String?
  file_type     String?   // "pdf", "image", "csv", "doc"
  file_size     Int?
  uploaded_by   String    @default("admin") // "admin" or "merchant"
  visibility    String    @default("both") // "admin", "merchant", "both"
  status        String    @default("pending") // "pending", "approved", "rejected"
  required      Boolean   @default(false)
  upload_token  String?   @unique // For standalone upload links
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  merchant      Merchant? @relation(fields: [merchant_id], references: [id], onDelete: SetNull)

  @@index([merchant_id])
  @@index([status])
  @@index([upload_token])
  @@map("documents")
}
